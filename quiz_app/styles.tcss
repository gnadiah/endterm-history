Screen {
    background: $surface;
}

/* ─── Menu ─── */
#menu-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

#menu-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    width: 100%;
}

#menu-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
    width: 100%;
}

.menu-btn {
    width: 100%;
    margin: 0 0;
}

#menu-buttons {
    width: 70;
    height: auto;
    align: center middle;
}

/* ─── Section Select ─── */
#section-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

#section-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
    width: 100%;
}

#section-buttons {
    width: 90;
    height: auto;
    align: center middle;
}

.section-btn {
    width: 100%;
    margin: 0 0;
}

/* ─── Quiz ─── */
#quiz-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#quiz-progress-label {
    text-align: center;
    width: 100%;
    color: $text;
    text-style: bold;
}

#quiz-progress-bar {
    width: 1fr;
    margin: 0 0 1 0;
}

#quiz-progress-bar Bar {
    width: 1fr;
}

#quiz-question {
    width: 100%;
    padding: 1 2;
    margin-bottom: 1;
    background: $panel;
    border: round $accent;
    min-height: 3;
}

#quiz-passage {
    width: 100%;
    padding: 1 2;
    margin-bottom: 1;
    background: $boost;
    border: round $secondary;
    max-height: 12;
    overflow-y: auto;
}

#quiz-sub-question {
    width: 100%;
    padding: 1 2;
    margin-bottom: 1;
    background: $panel;
    border: round $accent;
}

#quiz-options {
    width: 100%;
    height: auto;
    padding: 0 1;
}

.option-btn {
    width: 100%;
    margin: 0 0;
    min-height: 3;
    content-align: left middle;
}

.option-btn.correct {
    background: $success;
    color: $text;
}

.option-btn.wrong {
    background: $error;
    color: $text;
}

/* True/False buttons */
.tf-btn {
    width: 1fr;
    margin: 0 2;
    min-height: 3;
}

.tf-btn.correct {
    background: $success;
}

.tf-btn.wrong {
    background: $error;
}

#tf-options {
    width: 100%;
    layout: horizontal;
    height: auto;
    padding: 0 4;
}

/* ─── Results ─── */
#results-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
    align: center top;
}

#results-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    width: 100%;
    margin-bottom: 1;
}

#results-score {
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#results-time {
    text-align: center;
    width: 100%;
    color: $text-muted;
    margin-bottom: 1;
}

#results-wrong-title {
    text-style: bold;
    color: $error;
    margin: 1 0;
}

#results-wrong-list {
    width: 100%;
    height: 1fr;
    margin-bottom: 1;
    border: round $error;
    padding: 1;
    overflow-y: auto;
}

#results-buttons {
    width: 100%;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.results-btn {
    margin: 0 2;
}

/* ─── History ─── */
#history-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#history-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    width: 100%;
    margin-bottom: 1;
}

#history-table {
    width: 100%;
    height: 1fr;
}
